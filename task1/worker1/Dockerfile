# Базовый образ: лёгкий официальный Python 3.12 на slim-варианте Debian.
# slim меньше полного образа и не тянет лишние пакеты — нам достаточно
# стандартной библиотеки, никаких pip-зависимостей у worker1 нет.
FROM python:3.12.1-slim

# Рабочая директория внутри контейнера.
# Все относительные пути (если бы они были) считались бы от неё.
WORKDIR /app

# Копируем только сам скрипт приложения из контекста сборки.
# Так в образ не попадут лишние файлы из каталога worker1.
COPY process.py /app/process.py

# Команда запуска контейнера: выполняем скрипт.
# exec-форма (JSON-массив) предпочтительнее shell-формы,
# так как процесс получает PID 1 и корректно обрабатывает сигналы.
CMD ["python", "/app/process.py"]